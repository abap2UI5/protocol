{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/abap2UI5/protocol/schema/request.schema.json",
  "title": "abap2UI5 roundtrip request, protocol 3",
  "description": "The JSON body of a roundtrip POST (spec/request.md). A frontend sends the payload wrapped as { \"value\": <payload> }; a backend also accepts the bare payload, because a launchpad shell or a gateway may strip the envelope (spec/transport.md).",
  "anyOf": [
    {
      "type": "object",
      "required": [
        "value"
      ],
      "properties": {
        "value": {
          "$ref": "#/$defs/payload"
        }
      },
      "additionalProperties": false
    },
    {
      "$ref": "#/$defs/payload"
    }
  ],
  "$defs": {
    "payload": {
      "type": "object",
      "properties": {
        "S_FRONT": {
          "$ref": "#/$defs/sFront"
        },
        "MODEL": {
          "$ref": "#/$defs/modelDelta"
        }
      },
      "additionalProperties": false
    },
    "sFront": {
      "type": "object",
      "properties": {
        "ID": {
          "description": "The draft id of the response this request continues. Absent (or empty) on an app-start-shaped request.",
          "type": "string"
        },
        "EVENT": {
          "description": "The backend event name - the first element of the event array of the wire that fired.",
          "type": "string"
        },
        "T_EVENT_ARG": {
          "description": "The further arguments of the wire, as raw JSON values. The backend hands each to the app as a string (spec/request.md#event-arguments).",
          "type": "array",
          "maxItems": 100
        },
        "HASH": {
          "description": "window.location.hash, on every request that has one (not for an embedded component). For the app to read - a backend resolves no app start from it (spec/request.md#route).",
          "type": "string"
        },
        "ROUTE": {
          "$ref": "#/$defs/route"
        },
        "ORIGIN": {
          "type": "string"
        },
        "PATHNAME": {
          "type": "string"
        },
        "SEARCH": {
          "description": "window.location.search - carries ?app_start=<CLASS> on an app start.",
          "type": "string"
        },
        "MS_CLIENT_PREV": {
          "description": "Duration of the previous roundtrip as the browser measured it, in milliseconds. Diagnostic only.",
          "type": "integer",
          "minimum": 0
        },
        "CONFIG": {
          "$ref": "#/$defs/config"
        }
      },
      "additionalProperties": false,
      "if": {
        "required": [
          "EVENT"
        ],
        "properties": {
          "EVENT": {
            "const": "___ZZZ_WIN"
          }
        }
      },
      "then": {
        "required": [
          "ID",
          "T_EVENT_ARG"
        ],
        "properties": {
          "ID": {
            "description": "A window request continues a draft - it is never an app start.",
            "type": "string",
            "minLength": 1
          },
          "T_EVENT_ARG": {
            "$ref": "#/$defs/windowRequest"
          }
        }
      }
    },
    "route": {
      "description": "What the hash of the page asks an app start to restore, parsed by the frontend (spec/request.md#route): the class of a route #/app/<CLASS>, with the draft of #/app/<CLASS>/<DRAFT>, or the draft of an app-state link #/z2ui5-xapp-state=<DRAFT>. Only on a request without ID; absent when the hash names neither.",
      "type": "object",
      "minProperties": 1,
      "properties": {
        "APP": {
          "description": "The class a route names.",
          "type": "string",
          "minLength": 1
        },
        "DRAFT": {
          "description": "The draft a route names behind its class.",
          "type": "string",
          "minLength": 1
        },
        "APP_STATE": {
          "description": "The draft an app-state link names.",
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false,
      "if": {
        "required": [
          "DRAFT"
        ],
        "properties": {
          "DRAFT": {
            "type": "string"
          }
        }
      },
      "then": {
        "required": [
          "APP"
        ],
        "properties": {
          "APP": {
            "type": "string"
          }
        }
      }
    },
    "windowRequest": {
      "description": "The arguments of the reserved window event ___ZZZ_WIN (spec/windowed-tables.md#the-window-request): the model path of the windowed table, the app's event (EVENT of its window state), the reason, skip and top - and, for SORT and FILTER, the sorters and the filter groups, both, each as the text of a JSON array. The backend hands them to the app as its event with the request in get( )-r_event_data.",
      "type": "array",
      "minItems": 5,
      "maxItems": 7,
      "prefixItems": [
        {
          "description": "The model path of the table, with its leading slash: /T_ROWS.",
          "type": "string",
          "pattern": "^/"
        },
        {
          "description": "The app's event: EVENT of the table's window state.",
          "type": "string",
          "minLength": 1
        },
        {
          "description": "Why the frontend asks: MORE (more rows), SORT, FILTER (the first rows of a new order).",
          "enum": [
            "MORE",
            "SORT",
            "FILTER"
          ]
        },
        {
          "description": "skip: the rows the frontend holds - where MORE goes on; 0 for SORT and FILTER. The UI5 frontend sends it as a string.",
          "type": "string",
          "pattern": "^[0-9]{1,9}$"
        },
        {
          "description": "top: the rows wanted now - whole windows, at most TOTAL. The UI5 frontend sends it as a string.",
          "type": "string",
          "pattern": "^[0-9]{1,9}$"
        },
        {
          "description": "The sorters: the text of [{ \"PATH\": <column>, \"DESCENDING\": <boolean> }, ...] - [] for none.",
          "type": "string"
        },
        {
          "description": "The filter groups: the text of [[[<column>, <operator>, <value1>, <value2>], ...], ...] - the groups ANDed, the conditions of a group ORed; [] for none.",
          "type": "string"
        }
      ],
      "if": {
        "prefixItems": [
          true,
          true,
          {
            "enum": [
              "SORT",
              "FILTER"
            ]
          }
        ]
      },
      "then": {
        "minItems": 7
      },
      "else": {
        "maxItems": 5
      }
    },
    "config": {
      "type": "object",
      "properties": {
        "S_UI5": {
          "type": "object",
          "properties": {
            "VERSION": {
              "type": "string"
            },
            "BUILDTIMESTAMP": {
              "type": "string"
            },
            "GAV": {
              "type": "string"
            },
            "THEME": {
              "type": "string"
            }
          },
          "additionalProperties": false
        },
        "S_DEVICE": {
          "type": "object",
          "properties": {
            "SYSTEM": {
              "enum": [
                "phone",
                "tablet",
                "desktop",
                "combi"
              ]
            },
            "ORIENTATION": {
              "enum": [
                "portrait",
                "landscape"
              ]
            },
            "BROWSER": {
              "$ref": "#/$defs/nameVersion"
            },
            "OS": {
              "$ref": "#/$defs/nameVersion"
            },
            "RESIZE": {
              "type": "object",
              "properties": {
                "WIDTH": {
                  "type": "integer",
                  "minimum": 0
                },
                "HEIGHT": {
                  "type": "integer",
                  "minimum": 0
                }
              },
              "additionalProperties": false
            },
            "SUPPORT": {
              "type": "object",
              "properties": {
                "TOUCH": {
                  "type": "boolean"
                },
                "POINTER": {
                  "type": "boolean"
                },
                "RETINA": {
                  "type": "boolean"
                }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        },
        "S_FOCUS": {
          "type": "object",
          "required": [
            "ID"
          ],
          "properties": {
            "ID": {
              "type": "string"
            },
            "SELECTION_START": {
              "type": "integer",
              "minimum": 0
            },
            "SELECTION_END": {
              "type": "integer",
              "minimum": 0
            }
          },
          "additionalProperties": false
        },
        "S_SCROLL": {
          "type": "object",
          "propertyNames": {
            "enum": [
              "MAIN",
              "NEST",
              "NEST2",
              "POPUP",
              "POPOVER"
            ]
          },
          "additionalProperties": {
            "type": "object",
            "required": [
              "ID"
            ],
            "properties": {
              "ID": {
                "type": "string"
              },
              "X": {
                "type": "number"
              },
              "Y": {
                "type": "number"
              }
            },
            "additionalProperties": false
          }
        },
        "ComponentData": {
          "description": "The launchpad's component data (startupParameters, ...), as the shell handed it over.",
          "type": "object"
        }
      },
      "additionalProperties": false
    },
    "nameVersion": {
      "type": "object",
      "properties": {
        "NAME": {
          "type": "string"
        },
        "VERSION": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "modelDelta": {
      "description": "The model delta: per top-level attribute either its whole current value, or - for a table edited by row - { \"__delta\": { \"<0-based row>\": { \"<COLUMN>\": value | <nested delta> } } }; for a table behind a data reference (the model node <attr>/*) the same on the * node: { \"*\": { \"__delta\": ... } } (spec/request.md#the-model-delta).",
      "type": "object",
      "additionalProperties": {
        "allOf": [
          {
            "if": {
              "type": "object",
              "required": [
                "__delta"
              ],
              "properties": {
                "__delta": true
              }
            },
            "then": {
              "$ref": "#/$defs/tableDelta"
            }
          },
          {
            "if": {
              "type": "object",
              "required": [
                "*"
              ],
              "properties": {
                "*": {
                  "type": "object",
                  "required": [
                    "__delta"
                  ],
                  "properties": {
                    "__delta": true
                  }
                }
              }
            },
            "then": {
              "type": "object",
              "properties": {
                "*": {
                  "$ref": "#/$defs/tableDelta"
                }
              }
            }
          }
        ]
      }
    },
    "tableDelta": {
      "type": "object",
      "required": [
        "__delta"
      ],
      "properties": {
        "__delta": {
          "type": "object",
          "propertyNames": {
            "pattern": "^[0-9]+$"
          },
          "additionalProperties": {
            "type": "object",
            "additionalProperties": {
              "if": {
                "type": "object",
                "required": [
                  "__delta"
                ],
                "properties": {
                  "__delta": true
                }
              },
              "then": {
                "$ref": "#/$defs/tableDelta"
              }
            }
          }
        }
      },
      "additionalProperties": false
    }
  }
}
