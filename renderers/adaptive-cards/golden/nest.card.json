{
  "card": {
    "type": "AdaptiveCard",
    "$schema": "http://adaptivecards.io/schemas/adaptive-card.json",
    "version": "1.5",
    "body": [
      {
        "type": "Container",
        "id": "slot-MAIN",
        "items": [
          {
            "type": "TextBlock",
            "text": "conformance - slots",
            "wrap": true,
            "size": "Large",
            "weight": "Bolder",
            "style": "heading"
          },
          {
            "type": "ActionSet",
            "actions": [
              {
                "type": "Action.Submit",
                "title": "Popup",
                "data": {
                  "event": "POPUP_OPEN"
                }
              },
              {
                "type": "Action.Submit",
                "title": "Popover",
                "data": {
                  "event": "POPOVER_OPEN"
                }
              },
              {
                "type": "Action.Submit",
                "title": "Nest",
                "data": {
                  "event": "NEST_OPEN"
                }
              },
              {
                "type": "Action.Submit",
                "title": "Nest2",
                "data": {
                  "event": "NEST2_OPEN"
                }
              }
            ]
          }
        ]
      },
      {
        "type": "Container",
        "id": "slot-NEST",
        "items": [
          {
            "type": "RichTextBlock",
            "inlines": [
              {
                "type": "TextRun",
                "text": "[NEST view - not rendered]",
                "isSubtle": true
              }
            ]
          }
        ]
      }
    ]
  },
  "unsupported": [
    {
      "slot": "NEST",
      "control": "NEST",
      "reason": "nested view slot - not in portable profile v1, placeholder"
    }
  ]
